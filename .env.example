# --- Identidad de la instancia ---
MODE=local
PORT=3000
BASE_URL=http://localhost:3000
COOKIE_SECURE=false

# --- Datos y almacenamiento ---
DATA_DIR=./data
AI_KEYS_AES_AAD="aulaplay:v1"

# --- Sesión y seguridad ---
SESSION_TTL_MS=43200000
SESSION_TTL_STUDENT_MS=28800000
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MS=300000

# --- Límites globales de IA ---
AI_TIMEOUT_MS=90000
AI_MAX_TOKENS=4096
AI_RATE_PER_MIN=10

# --- Backup y retención ---
BACKUP_ENABLED=true
BACKUP_INTERVAL_H=24
BACKUP_RETENTION=7
